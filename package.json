{
  "name": "a11y-toast",
  "version": "1.0.0",
  "description": "Framework-free TypeScript toast notifications with explicit announcement ownership and deterministic lifecycle cleanup.",
  "type": "module",
  "license": "MIT",
  "author": "Vasileios Mitsaras",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vmitsaras/A11y-Toast.git"
  },
  "bugs": {
    "url": "https://github.com/vmitsaras/A11y-Toast/issues"
  },
  "homepage": "https://vmitsaras.github.io/A11y-Toast/",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./docs": {
      "types": "./dist/docs.d.ts",
      "import": "./dist/docs.js"
    },
    "./styles.css": "./dist/styles.css",
    "./skins/minimal.css": "./dist/skins/minimal.css",
    "./skins/compact.css": "./dist/skins/compact.css",
    "./skins/rounded.css": "./dist/skins/rounded.css",
    "./skins/classic-light.css": "./dist/skins/classic-light.css",
    "./skins/classic-dark.css": "./dist/skins/classic-dark.css",
    "./skins/snackbar.css": "./dist/skins/snackbar.css",
    "./skins/soft.css": "./dist/skins/soft.css",
    "./skins/outline.css": "./dist/skins/outline.css",
    "./skins/solid.css": "./dist/skins/solid.css",
    "./skins/accent-rail.css": "./dist/skins/accent-rail.css",
    "./skins/top-rule.css": "./dist/skins/top-rule.css",
    "./skins/split-panel.css": "./dist/skins/split-panel.css",
    "./skins/header-band.css": "./dist/skins/header-band.css",
    "./skins/action-footer.css": "./dist/skins/action-footer.css",
    "./skins/monochrome.css": "./dist/skins/monochrome.css",
    "./package.json": "./package.json",
    "./addons/progress": {
      "types": "./dist/addons/progress.d.ts",
      "import": "./dist/addons/progress.js"
    },
    "./addons/progress.css": "./dist/addons/progress.css",
    "./addons/swipe-dismiss": {
      "types": "./dist/addons/swipe-dismiss.d.ts",
      "import": "./dist/addons/swipe-dismiss.js"
    },
    "./addons/swipe-dismiss.css": "./dist/addons/swipe-dismiss.css",
    "./addons/promise": {
      "types": "./dist/addons/promise.d.ts",
      "import": "./dist/addons/promise.js"
    },
    "./addons/history": {
      "types": "./dist/addons/history.d.ts",
      "import": "./dist/addons/history.js"
    },
    "./addons/diagnostics": {
      "types": "./dist/addons/diagnostics.d.ts",
      "import": "./dist/addons/diagnostics.js"
    },
    "./addons/dedupe": {
      "types": "./dist/addons/dedupe.d.ts",
      "import": "./dist/addons/dedupe.js"
    },
    "./adapters/dom-events": {
      "types": "./dist/adapters/dom-events.d.ts",
      "import": "./dist/adapters/dom-events.js"
    },
    "./adapters/menu-button-async-state": {
      "types": "./dist/adapters/menu-button-async-state.d.ts",
      "import": "./dist/adapters/menu-button-async-state.js"
    },
    "./transports/aria-notify": {
      "types": "./dist/transports/aria-notify.d.ts",
      "import": "./dist/transports/aria-notify.js"
    },
    "./animations/gsap": {
      "types": "./dist/animations/gsap.d.ts",
      "import": "./dist/animations/gsap.js"
    },
    "./animations/gsap-flip": {
      "types": "./dist/animations/gsap-flip.d.ts",
      "import": "./dist/animations/gsap-flip.js"
    },
    "./animations/view-transition": {
      "types": "./dist/animations/view-transition.d.ts",
      "import": "./dist/animations/view-transition.js"
    },
    "./animations/view-transition.css": "./dist/animations/view-transition.css"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run pages:build",
    "build:dist": "npm run clean && tsdown && node scripts/copy-assets.mjs",
    "build:portable": "npm run clean && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "pages:generate": "node scripts/build-pages.mjs",
    "pages:build": "npm run build:dist && npm run pages:generate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:browser": "node scripts/browser-test.mjs",
    "test:package": "node scripts/package-test.mjs",
    "demo": "node scripts/serve.mjs",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "prepack": "npm run build:dist",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "a11y-menu-button": "^1.0.1",
    "gsap": "^3.15.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.51.1",
    "tsdown": "^0.15.0",
    "typescript": "~5.8.3",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "accessibility",
    "toast",
    "typescript",
    "live-region",
    "vanilla-js"
  ],
  "peerDependencies": {
    "a11y-menu-button": "^1.0.1",
    "gsap": ">=3.11.0 <4"
  },
  "peerDependenciesMeta": {
    "a11y-menu-button": {
      "optional": true
    },
    "gsap": {
      "optional": true
    }
  }
}
